{
    "description": "Mixed graph training config — trains on all graph types, minimize LCC. Best for generalization.",
    "graph_type": ["erdos_renyi", "powerlaw", "small-world", "barabasi_albert"],
    "centrality_feature_name": ["degree", "eigen", "pagerank", "ci"],
    "global_feature_name": ["heterogeneity", "resilience", "entropy"],
    "GNN": ["utils/reinforcement_learning/GraphNN.py", "GraphNN"],
    "gnn_model": "GAT",
    "objective_function": "largestConnectedComponent",
    "centrality_features": 4,
    "global_features": 3,
    "alpha": 0.5,
    "num_train_episodes": 500000,
    "eval_every": 500,
    "save_every": 500,
    "graph_batch_size": 1000,
    "graph_suffle": 1000,
    "validation_test_size": 10,
    "hidden_layers": [[5, 3], [2, 3], [2, 2, 1]],
    "replay_buffer_capacity": 100000,
    "batch_size": 32,
    "learning_rate": 0.001,
    "update_target_network_every": 1000,
    "learn_every": 100,
    "discount_factor": 0.99,
    "min_buffer_size_to_learn": 1000,
    "epsilon_power": 4.0,
    "nstep": 3,
    "epsilon_start": 1.0,
    "epsilon_end": 0.01,
    "epsilon_decay_duration": 20000000,
    "checkpoint_dir": "./model/mixed_minmax/checkpoint",
    "training_log": "./log/mixed_minmax_training.json"
}
